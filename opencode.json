{
  "$schema": "https://opencode.ai/config.json",
  "lsp": {
    "dart": {
      "command": [
        "./app/.fvm/flutter_sdk/bin/dart",
        "language-server",
        "--protocol=lsp"
      ],
      "extensions": [".dart"]
    },
    "deno": {
      "command": ["deno", "lsp"],
      "extensions": [".ts", ".tsx", ".js", ".jsx", ".mjs"]
    },
    "typescript": {
      "disabled": true
    }
  }
}
